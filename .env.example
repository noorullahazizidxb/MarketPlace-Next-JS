# Local frontend. Copy to .env
# See examples/local.env.example. For Vercel, see .env.vercel.example.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:4000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_API_HOST=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_IO_ENABLED=true
NEXT_PUBLIC_ENABLE_ELASTIC_SEARCH=false
SEARCH_ENABLED=false

BACKEND_VERCEL_URL=

BLOG_ORIGIN=http://localhost:3000
MARKETPLACE_ORIGIN=http://localhost:3000
# reCAPTCHA v3 site key only (score-based). A v2 checkbox key shows "Invalid key type".
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Server secret for https://www.google.com/recaptcha/api/siteverify. Never expose this to the browser.
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=31499082252-m5fqgaeur47qrkau3fhcl9dmtsd1m6lr.apps.googleusercontent.com
GOOGLE_CLIENT_ID=31499082252-m5fqgaeur47qrkau3fhcl9dmtsd1m6lr.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_URL=/api/auth/google
NEXT_PUBLIC_FACEBOOK_APP_ID=1431416712518258
FACEBOOK_APP_ID=1431416712518258
FACEBOOK_APP_SECRET=
NEXT_PUBLIC_FACEBOOK_AUTH_URL=/api/auth/facebook
RECAPTCHA_MIN_SCORE=0.5
