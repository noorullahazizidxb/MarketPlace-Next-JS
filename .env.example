# Docker / local keys. For Vercel same-domain, see .env.vercel.example

NEXT_PUBLIC_SITE_URL=https://marketplace.devminds.net
NEXT_PUBLIC_API_BASE=https://marketplace.devminds.net/api
NEXT_PUBLIC_API_BASE_URL=https://marketplace.devminds.net/api
NEXT_PUBLIC_API_HOST=https://marketplace.devminds.net
NEXT_PUBLIC_WS_URL=https://marketplace.devminds.net
NEXT_PUBLIC_SOCKET_URL=https://marketplace.devminds.net
NEXT_PUBLIC_SOCKET_IO_ENABLED=true
NEXT_PUBLIC_ENABLE_ELASTIC_SEARCH=false
SEARCH_ENABLED=false

# Vercel rewrite target (API *.vercel.app). Empty for nginx /api proxy.
BACKEND_VERCEL_URL=

BLOG_ORIGIN=https://blogs.devminds.net
MARKETPLACE_ORIGIN=https://marketplace.devminds.net
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
