{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/theme/*": [
        "./src/theme/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/lib/*": [
        "./src/lib/*"
      ],
      "@/hooks/*": [
        "./src/hooks/*"
      ],
      "@/mock": [
        "./src/mock/index.ts"
      ],
      "@/mock/*": [
        "./src/mock/*"
      ],
      "@/store/*": [
        "./src/store/*"
      ],
      "@repo/hooks": [
        "./src/lib/repo/hooks.tsx"
      ],
      "@repo/hooks/motion": [
        "./src/lib/repo/motion.ts"
      ],
      "@repo/hooks/src/theme/context/theme-context": [
        "./src/lib/theme/theme-context.tsx"
      ],
      "@repo/constants": [
        "./src/lib/repo/constants.ts"
      ],
      "@repo/types": [
        "./src/lib/repo/types.ts"
      ],
      "@repo/types/ui-context": [
        "./src/lib/theme/types.ts"
      ],
      "@repo/theme": [
        "./src/lib/repo/theme.tsx"
      ],
      "@repo/ui": [
        "./src/lib/repo/ui.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/types/**/*.d.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
