# Turso would be a backend database. This frontend has no database URL.
# The backend Prisma client cannot use libsql:// yet, so do not point this
# site at an API that expects Turso. Use the local or Vercel example instead.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:4000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_API_HOST=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_IO_ENABLED=true
NEXT_PUBLIC_ENABLE_ELASTIC_SEARCH=false
SEARCH_ENABLED=false

BACKEND_VERCEL_URL=

BLOG_ORIGIN=http://localhost:3000
MARKETPLACE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
